[Unit]
Description=AHUIKE triage API
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/ahuike
EnvironmentFile=/etc/ahuike.env
ExecStart=/home/ubuntu/venv/bin/uvicorn api.server:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
